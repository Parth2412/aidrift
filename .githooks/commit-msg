#!/usr/bin/env sh
set -eu

commit_msg_file="$1"

if grep -Eiq '(^|\n)Co-authored-by:' "$commit_msg_file"; then
  echo "Commit rejected: co-authored commits are not allowed in AIDRIFT." >&2
  exit 1
fi

if grep -Eiq '(Claude|Codex|OpenAI|Anthropic|AI assistant|Generated-by|Generated by)' "$commit_msg_file"; then
  echo "Commit rejected: AI assistant attribution is not allowed in commit messages." >&2
  exit 1
fi
