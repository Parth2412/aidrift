{
  "name": "aidrift",
  "version": "0.0.0",
  "description": "CLI for versioning, diffing, testing, and gating AI behavioral state.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "aidrift": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:check-coverage": "vitest run tests/check.test.ts --coverage.enabled true --coverage.provider v8 --coverage.include src/commands/check.ts --coverage.reporter text --coverage.thresholds.lines 90",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aidrift/core": "workspace:*",
    "@aidrift/sdk": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "ajv": "^8.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
